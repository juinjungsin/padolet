rules_version = '2';

// padolet Firestore 보안 규칙
// 설계 원칙
// - 기본 deny. 필요한 경로만 명시적으로 열기.
// - 인증은 Firebase Auth 기준 (NextAuth와 이중 로그인 동기화 필요).
//   super_admin / delegated admin: Google credential 로그인 → request.auth.token.email 검증
//   참여자: signInAnonymously → request.auth.uid로 식별
// - 세션 소유자 판별은 sessions/{sessionId}.createdBy == request.auth.uid 로 통일
// - 포스트잇/메시지의 authorId는 firebase auth uid 저장
// - 참여자 문서 ID는 firebase auth uid 사용 → 참여 여부 판별을 exists()로 O(1)

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 헬퍼 ----------

    function isAuthed() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthed() && request.auth.token.email == 'jongbin@gmail.com';
    }

    // delegated admin — admins/{email} 문서 존재로 판별
    function isDelegatedAdmin() {
      return isAuthed()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function isAdmin() {
      return isSuperAdmin() || isDelegatedAdmin();
    }

    // 세션 관리자 = super_admin 또는 해당 세션 소유자
    function isSessionAdmin(sessionId) {
      return isSuperAdmin()
        || (isAuthed()
            && get(/databases/$(database)/documents/sessions/$(sessionId)).data.createdBy == request.auth.uid);
    }

    // 세션 참여자 = participants/{uid} 도큐먼트 존재
    function isSessionParticipant(sessionId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(request.auth.uid));
    }

    // 보드 잠금 여부 — 잠금 중에는 참여자 쓰기(작성/편집/삭제/리액션) 차단
    function isBoardLocked(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('locked', false) == true;
    }

    // 본인 작성물 편집 가능 시간 (5분) — 앱 로직과 동일
    function withinEditWindow(createdAt) {
      return createdAt != null
        && request.time < createdAt + duration.value(5, 'm');
    }

    // ---------- admins ----------
    // NextAuth signIn callback이 read함 → 공개 read 유지
    // write는 super_admin만
    match /admins/{email} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ---------- sessions ----------
    match /sessions/{sessionId} {
      // 조회는 공개 (참여자가 로그인 전에 코드로 세션 찾기 위해서라도 필요)
      allow read: if true;

      // 생성: 관리자만, createdBy는 반드시 본인 uid
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid;

      // 수정/삭제: 소유자 또는 super_admin
      allow update, delete: if isSuperAdmin()
        || (isAuthed() && resource.data.createdBy == request.auth.uid);

      // ---------- participants ----------
      // 문서 ID = firebase auth uid
      match /participants/{participantId} {
        allow read: if true;

        // 참여자 본인만 자신의 문서 생성 (익명 로그인 후)
        allow create: if isAuthed()
          && participantId == request.auth.uid;

        // 본인 문서만 업데이트 (isOnline, lastSeenAt 등)
        allow update: if isAuthed()
          && participantId == request.auth.uid;

        // 삭제는 세션 관리자만 (본인 탈퇴는 update로 표현)
        allow delete: if isSessionAdmin(sessionId);
      }

      // ---------- posts (포스트잇) ----------
      match /posts/{postId} {
        allow read: if true;

        // 유형(kind) 허용 목록. 공지와 강사 표시(authorRole=admin)는 세션 관리자만 (2026-10 P1-02)
        function validPostKind() {
          return request.resource.data.get('kind', 'general')
            in ['general', 'notice', 'material', 'question', 'prompt'];
        }
        function adminOnlyPostFields() {
          return request.resource.data.get('kind', 'general') == 'notice'
            || request.resource.data.get('authorRole', 'participant') == 'admin'
            // 질문 상태는 접수로만 시작, '저도 궁금해요'는 빈 채로, 대화→질문 이동 표시는 강사만 (P1-03)
            || request.resource.data.get('questionStatus', 'open') != 'open'
            || request.resource.data.get('meToo', []).size() > 0
            || request.resource.data.keys().hasAny(['sourceMessageId', 'originalAuthorId', 'originalAuthorName', 'resolvedAt']);
        }

        // '저도 궁금해요' — 본인 식별자 하나만 추가하거나 빼는 변경 (P1-03)
        function onlyOwnMeTooToggle() {
          let before = resource.data.get('meToo', []).toSet();
          let after = request.resource.data.get('meToo', []).toSet();
          let added = after.difference(before);
          let removed = before.difference(after);
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['meToo'])
            && ((added.size() == 1 && added.hasOnly([request.auth.uid]) && removed.size() == 0)
                || (removed.size() == 1 && removed.hasOnly([request.auth.uid]) && added.size() == 0));
        }

        // 세션 참여자만 작성 (보드 잠금 중에는 관리자만). authorId는 반드시 본인 uid
        allow create: if isAuthed()
          && request.resource.data.authorId == request.auth.uid
          && validPostKind()
          && (isSessionAdmin(sessionId)
              || (isSessionParticipant(sessionId)
                  && !isBoardLocked(sessionId)
                  && !adminOnlyPostFields()));

        // 수정: 본인(5분 이내, 본문·제목·사용 목적만) 또는 세션 관리자 — 잠금 중에는 관리자만
        // 리액션: 세션 참여자는 reactions 필드만 수정 가능 (다른 필드 변경 불가)
        // 댓글: 세션 참여자는 commentCount만 수정 가능 (댓글 작성/삭제 시 증감)
        allow update: if isSessionAdmin(sessionId)
          || (isAuthed()
              && resource.data.authorId == request.auth.uid
              && withinEditWindow(resource.data.createdAt)
              && !isBoardLocked(sessionId)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['content', 'editedAt', 'title', 'purpose']))
          || (isSessionParticipant(sessionId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
              && !isBoardLocked(sessionId))
          || (isSessionParticipant(sessionId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
              && !isBoardLocked(sessionId))
          || (isSessionParticipant(sessionId)
              && onlyOwnMeTooToggle()
              && !isBoardLocked(sessionId));

        // 삭제: 본인(잠금 중 제외) 또는 세션 관리자
        allow delete: if isSessionAdmin(sessionId)
          || (isAuthed()
              && resource.data.authorId == request.auth.uid
              && !isBoardLocked(sessionId));

        // ---------- comments (포스트잇 댓글) ----------
        match /comments/{commentId} {
          allow read: if true;

          // 세션 참여자만 작성 (보드 잠금 중에는 관리자만). authorId는 반드시 본인 uid
          allow create: if isAuthed()
            && request.resource.data.authorId == request.auth.uid
            && (isSessionAdmin(sessionId)
                || (isSessionParticipant(sessionId) && !isBoardLocked(sessionId)));

          // 삭제: 본인(잠금 중 제외) 또는 세션 관리자
          allow delete: if isSessionAdmin(sessionId)
            || (isAuthed()
                && resource.data.authorId == request.auth.uid
                && !isBoardLocked(sessionId));
        }
      }

      // ---------- messages (대화) ----------
      match /messages/{messageId} {
        allow read: if true;

        // 세션 참여자만 작성 (보드 잠금 중에는 관리자만)
        allow create: if isAuthed()
          && request.resource.data.authorId == request.auth.uid
          && (isSessionAdmin(sessionId)
              || (isSessionParticipant(sessionId) && !isBoardLocked(sessionId)));

        // 수정: 본인(5분 이내, 잠금 중 제외) 또는 세션 관리자 (모더레이션 hidden 필드 토글용)
        allow update: if isSessionAdmin(sessionId)
          || (isAuthed()
              && resource.data.authorId == request.auth.uid
              && withinEditWindow(resource.data.createdAt)
              && !isBoardLocked(sessionId));

        // 삭제: 세션 관리자만
        allow delete: if isSessionAdmin(sessionId);
      }

      // ---------- modules (현재 실습 안내, P1-01) ----------
      match /modules/{moduleId} {
        allow read: if true;
        allow create, update, delete: if isSessionAdmin(sessionId);
      }

      // 문서 ID = {moduleId}__{uid} — 같은 실습·같은 참여자는 문서 하나 (반복 클릭으로 집계 증가 없음)
      function isOwnMemberDoc(docId) {
        return isAuthed() && docId.split('__').size() == 2 && docId.split('__')[1] == request.auth.uid;
      }

      // ---------- progress (실습 진행 상태, P1-04) ----------
      // 이름 없이 uid·상태만 저장. 교육생에게는 집계만 보여 주므로 세션 참여자·관리자 열람
      match /progress/{progressId} {
        allow read: if isSessionParticipant(sessionId) || isSessionAdmin(sessionId);

        allow create, update: if isOwnMemberDoc(progressId)
          && isSessionParticipant(sessionId)
          && progressId == request.resource.data.moduleId + '__' + request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status in ['doing', 'done']
          && request.resource.data.keys().hasOnly(['moduleId', 'uid', 'status', 'updatedAt'])
          && exists(/databases/$(database)/documents/sessions/$(sessionId)/modules/$(request.resource.data.moduleId));

        // 상태 취소 = 본인 문서 삭제
        allow delete: if isOwnMemberDoc(progressId) || isSessionAdmin(sessionId);
      }

      // ---------- helpRequests (도움 요청, P1-04) ----------
      // 요청자 식별 정보는 본인과 강사만 열람. 처리(확인·완료)는 강사만, 진행 상태와는 별개 문서
      match /helpRequests/{helpId} {
        allow read: if isOwnMemberDoc(helpId) || isSessionAdmin(sessionId);

        allow create: if isOwnMemberDoc(helpId)
          && isSessionParticipant(sessionId)
          && helpId == request.resource.data.moduleId + '__' + request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'open'
          && request.resource.data.keys().hasOnly(['moduleId', 'uid', 'name', 'status', 'requestedAt']);

        // 본인: 다시 요청(open) 또는 취소(cancelled) — 처리 기록은 비운다
        // 강사: 확인·처리 완료·다시 열기
        allow update: if (isOwnMemberDoc(helpId)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'requestedAt', 'acknowledgedAt', 'resolvedAt', 'resolvedBy'])
              && request.resource.data.status in ['open', 'cancelled']
              && request.resource.data.get('acknowledgedAt', null) == null
              && request.resource.data.get('resolvedAt', null) == null
              && request.resource.data.get('resolvedBy', null) == null)
          || (isSessionAdmin(sessionId)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'acknowledgedAt', 'resolvedAt', 'resolvedBy'])
              && request.resource.data.status in ['open', 'acknowledged', 'resolved']);

        allow delete: if isSessionAdmin(sessionId);
      }

      // ---------- polls (투표/퀴즈) ----------
      match /polls/{pollId} {
        allow read: if true;

        // 세션 관리자만 생성/수정/삭제
        allow create, update, delete: if isSessionAdmin(sessionId);

        // ---------- votes ----------
        // 문서 ID = voter uid → 1인 1표
        match /votes/{voterId} {
          allow read: if true;

          allow create, update: if isAuthed()
            && voterId == request.auth.uid;

          allow delete: if isSessionAdmin(sessionId);
        }
      }
    }
  }
}
